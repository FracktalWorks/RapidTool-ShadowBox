# RapidTool-ToolTrace — Development
# Local dev: auth DISABLED (mock user) so no backend is needed.
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=10000
VITE_APP_URL=http://localhost:5173
VITE_PORTAL_URL=https://portal.appliedadditive.com

# Set false + run the backend to exercise real cookie auth locally.
VITE_DISABLE_AUTH=true

VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug
NODE_ENV=development

# Experimental: BiRefNet Lite tracer (chrome/reflective tools). Model at
# public/models/birefnet_lite.onnx (gitignored, 224MB). NOTE: fp32/1024² OOMs the
# browser (std::bad_alloc) — it captures chrome but must run on a BACKEND, not
# in-browser. Left commented; uncomment only to reproduce the OOM.
# VITE_TRACER=birefnet

# Backend tracer (BiRefNet on CPU). Start it with `node server/trace-server.cjs`,
# then uncomment to route crops there (falls back to in-browser IS-Net if down).
# VITE_TRACER_URL=http://localhost:8787
