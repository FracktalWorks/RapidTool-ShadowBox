# RapidTool-ToolTrace — Environment template (copy to .env.development / .env.production)

# Backend API base (client.ts appends /api). Same backend as the rest of RapidTool.
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=10000

# This app's URL + the Portal (used for the post-login redirect / unauthenticated bounce).
VITE_APP_URL=http://localhost:5173
VITE_PORTAL_URL=https://portal.appliedadditive.com

# true = mock user, no backend needed (local dev). false = real cookie auth.
VITE_DISABLE_AUTH=true

VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug

# Saliency tracer: isnet (default) | birefnet (handles chrome/reflective tools).
# For birefnet, drop the ONNX at public/models/birefnet_lite.onnx — see
# public/models/BIREFNET.md.
# VITE_TRACER=birefnet
# VITE_BIREFNET_URL=/models/birefnet_lite.onnx
# VITE_BIREFNET_PARTS=1

# Backend tracer (BiRefNet on CPU — captures chrome/reflective tools that
# in-browser IS-Net misses). Set to the tracer service base URL and the client
# POSTs each paper crop to {URL}/trace; if it's unreachable the app falls back to
# in-browser IS-Net automatically. Run the service: `node server/trace-server.cjs`.
# VITE_TRACER_URL=http://localhost:8787
